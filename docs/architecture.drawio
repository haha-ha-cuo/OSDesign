          <mxGeometry x="68" y="546" width="1144" height="24" as="geometry" />
        </mxCell>
        <mxCell id="scheduler-detail" value="&lt;div style=&quot;font-size:21px;font-weight:bold;&quot;&gt;进程调度&lt;/div&gt;&lt;div style=&quot;margin-top:5px;&quot;&gt;README 要求实现至少两种经典算法，以下是候选示例&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;FCFS 先来先服务&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;按就绪队列的到达顺序选择进程。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;SJF 短作业优先&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;优先选预计运行时间较短的作业。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;RR 时间片轮转&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;时间片耗尽后将未完成进程放回队列。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;优先级调度&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;根据优先级选择就绪进程。&lt;/div&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingLeft=17;spacingRight=17;spacingTop=17;spacingBottom=17;fontFamily=Arial;fontSize=15;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="613" width="566" height="324" as="geometry" />
        </mxCell>
        <mxCell id="tick-detail" value="&lt;div style=&quot;font-size:21px;font-weight:bold;&quot;&gt;模拟主循环&lt;/div&gt;&lt;div style=&quot;margin-top:5px;&quot;&gt;规划中的一个 tick&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;处理到达并派发&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;处理作业到达等事件，给空闲 CPU 装载选中的就绪进程。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;执行并推进时钟&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;CPU 执行一个 tick，主循环累计就绪等待，再统一推进时钟一次。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;处理节拍结果&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;完成时先终止再卸载。时间片耗尽时卸载，交给调度器重新入队。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;管理 PCB 的生命周期&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;设计上由进程表持有 PCB，队列保存 PID 或稳定引用。&lt;/div&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingLeft=17;spacingRight=17;spacingTop=17;spacingBottom=17;fontFamily=Arial;fontSize=15;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=5 4;" vertex="1" parent="1">
          <mxGeometry x="636" y="613" width="596" height="324" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="concurrency" name="同步、通信与死锁">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="759" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="canvas" value="" style="fillColor=#FFFFFF;strokeColor=none;movable=0;resizable=0;selectable=0;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1280" height="759" as="geometry" />
        </mxCell>
        <mxCell id="title" value="互斥与同步、进程通信、死锁处理" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=34;fontColor=#000000;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="48" y="30" width="1184" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="模块功能来自 README。底部给出各模块接入进程管理时的协作示例。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=17;fontColor=#000000;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="49" y="86" width="1182" height="29" as="geometry" />
        </mxCell>
        <mxCell id="sync" value="&lt;div style=&quot;font-size:21px;font-weight:bold;&quot;&gt;互斥与同步&lt;/div&gt;&lt;div style=&quot;margin-top:5px;&quot;&gt;规划&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;互斥锁&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;加锁与解锁，控制对临界区的互斥访问。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;信号量与 PV 操作&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;P 等待可用许可，V 释放许可，并可唤醒等待者。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;生产者–消费者&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;用信号量协调缓冲区空位和已有数据，用互斥保护缓冲区。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;读者–写者&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;协调多个读者与写者对共享数据的访问。&lt;/div&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingLeft=18;spacingRight=18;spacingTop=18;spacingBottom=18;fontFamily=Arial;fontSize=15;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=5 4;" vertex="1" parent="1">
          <mxGeometry x="48" y="137" width="378" height="362" as="geometry" />
        </mxCell>
        <mxCell id="ipc" value="&lt;div style=&quot;font-size:21px;font-weight:bold;&quot;&gt;进程通信&lt;/div&gt;&lt;div style=&quot;margin-top:5px;&quot;&gt;规划&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;共享内存&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;通过内存管理将同一区域映射到多个进程，需要协调访问时可接同步模块。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;消息队列&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;在消息缓冲区中保存待取出的消息，阻塞接收时调用进程管理。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;管道&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;一端写入，另一端按顺序读取字节。&lt;/div&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingLeft=18;spacingRight=18;spacingTop=18;spacingBottom=18;fontFamily=Arial;fontSize=15;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=5 4;" vertex="1" parent="1">
          <mxGeometry x="451" y="137" width="378" height="362" as="geometry" />
        </mxCell>
        <mxCell id="deadlock" value="&lt;div style=&quot;font-size:21px;font-weight:bold;&quot;&gt;死锁处理&lt;/div&gt;&lt;div style=&quot;margin-top:5px;&quot;&gt;规划&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;死锁预防&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;用资源申请规则破坏死锁的必要条件，例如规定资源申请顺序。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;死锁避免 · 银行家算法&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;使用最大需求、已分配量和可用量判断试分配后的安全性。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;死锁检测与恢复&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;读资源占用与等待记录检测环路等情况，恢复时可由进程管理撤销进程。&lt;/div&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingLeft=18;spacingRight=18;spacingTop=18;spacingBottom=18;fontFamily=Arial;fontSize=15;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=5 4;" vertex="1" parent="1">
          <mxGeometry x="854" y="137" width="378" height="362" as="geometry" />
