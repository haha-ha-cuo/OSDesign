        <mxCell id="memory" value="&lt;div style=&quot;font-size:21px;font-weight:bold;&quot;&gt;内存管理&lt;/div&gt;&lt;div style=&quot;margin-top:5px;&quot;&gt;规划&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;内存分配与回收&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;维护可用空间，为进程分配空间并在释放后回收。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;首次适应与最佳适应&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;首次适应选第一个够用的空闲块，最佳适应选最小的可用空闲块。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;分页与分段&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;模拟逻辑地址到物理位置的映射。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;换入与换出&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;依靠模拟磁盘的块读写，将进程数据换出或换回内存。&lt;/div&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingLeft=18;spacingRight=18;spacingTop=18;spacingBottom=18;fontFamily=Arial;fontSize=15;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=5 4;" vertex="1" parent="1">
          <mxGeometry x="48" y="137" width="378" height="362" as="geometry" />
        </mxCell>
        <mxCell id="disk" value="&lt;div style=&quot;font-size:21px;font-weight:bold;&quot;&gt;外存访问&lt;/div&gt;&lt;div style=&quot;margin-top:5px;&quot;&gt;规划&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;模拟磁盘&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;提供模拟磁盘空间和块读写。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;模拟文件系统&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;在模拟磁盘上管理文件标识、内容及所占空间。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;文件操作&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;创建、读取、写入、删除文件。&lt;/div&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingLeft=18;spacingRight=18;spacingTop=18;spacingBottom=18;fontFamily=Arial;fontSize=15;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=5 4;" vertex="1" parent="1">
          <mxGeometry x="451" y="137" width="378" height="362" as="geometry" />
        </mxCell>
        <mxCell id="thread" value="&lt;div style=&quot;font-size:21px;font-weight:bold;&quot;&gt;线程机制&lt;/div&gt;&lt;div style=&quot;margin-top:5px;&quot;&gt;规划中的用户级线程&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;创建&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;在进程内建立线程并登记线程状态。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;调度&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;从就绪线程中选择执行者并切换线程上下文。&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;&quot;&gt;撤销&lt;/div&gt;&lt;div style=&quot;margin-top:4px;line-height:1.42;&quot;&gt;终止线程并回收该线程的执行上下文。&lt;/div&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingLeft=18;spacingRight=18;spacingTop=18;spacingBottom=18;fontFamily=Arial;fontSize=15;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=5 4;" vertex="1" parent="1">
