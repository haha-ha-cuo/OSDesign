        <mxCell id="integration-title" value="与进程管理的协作示例" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=18;fontColor=#000000;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
