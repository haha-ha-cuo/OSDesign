          <mxGeometry as="geometry" x="700" y="960" width="240" height="80" />
        </mxCell>
        <mxCell id="switch" value="&lt;b&gt;上下文切换器&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;恢复被选对象的执行现场&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#5479B4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#22324A;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="1130" width="240" height="80" />
        </mxCell>
