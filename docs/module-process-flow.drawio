          <mxGeometry as="geometry" x="1200" y="540" width="500" height="35" />
        </mxCell>
        <mxCell id="creator" value="&lt;b&gt;创建器&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;接收创建请求&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#5479B4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#22324A;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="190" width="240" height="80" />
        </mxCell>
        <mxCell id="process" value="&lt;b&gt;进程&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;创建并初始化 PCB&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#5479B4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#22324A;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="340" width="240" height="80" />
        </mxCell>
        <mxCell id="memory" value="&lt;b&gt;内存管理&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;地址空间、装入与页面管理&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6EF;strokeColor=#548568;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#22324A;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="200" y="450" width="240" height="80" />
        </mxCell>
        <mxCell id="thread" value="&lt;b&gt;创建初始线程 / TCB&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;归属进程，共享进程资源&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#5479B4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#22324A;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="590" width="240" height="80" />
        </mxCell>
        <mxCell id="ready" value="&lt;b&gt;就绪队列&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;等待获得 CPU&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2EDFA;strokeColor=#8B70AD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#22324A;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="780" width="240" height="80" />
