<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device" compressed="false">
  <diagram id="module-process-flow" name="模块间过程图">
    <mxGraphModel dx="1800" dy="1720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1720" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="操作系统模拟系统 · 模块间过程图" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=32;fontColor=#22324A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="30" width="1500" height="55" />
        </mxCell>
        <mxCell id="subtitle" value="完整设计示意：创建 → 就绪 → 调度 → 执行 → 阻塞 / 唤醒 → 结束" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=19;fontColor=#526076;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="90" width="1600" height="35" />
        </mxCell>
        <mxCell id="section-memory" value="内存与外存" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#548568;fontStyle=1;" vertex="1" parent="1">
