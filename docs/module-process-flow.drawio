        </mxCell>
        <mxCell id="section-main" value="创建与调度主流程" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#5479B4;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="135" width="360" height="30" />
