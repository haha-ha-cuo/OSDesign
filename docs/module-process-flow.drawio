          <mxGeometry as="geometry" x="700" y="1320" width="240" height="80" />
        </mxCell>
        <mxCell id="save" value="&lt;b&gt;保存上下文&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;上下文切换的一部分&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2EDFA;strokeColor=#8B70AD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#22324A;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="1130" width="240" height="80" />
        </mxCell>
        <mxCell id="disk" value="&lt;b&gt;外存&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;程序、数据与换入页面&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6EF;strokeColor=#548568;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#22324A;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="780" width="240" height="80" />
        </mxCell>
        <mxCell id="sync" value="&lt;b&gt;同步与资源管理&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;锁、信号量与资源请求&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3DF;strokeColor=#B8893C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#22324A;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="1320" width="240" height="80" />
        </mxCell>
        <mxCell id="deadlock" value="&lt;b&gt;死锁避免&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;检查资源与分配安全性&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3DF;strokeColor=#B8893C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#22324A;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1500" y="1110" width="240" height="80" />
        </mxCell>
        <mxCell id="allow" value="&lt;b&gt;分配资源&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;继续执行&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3DF;strokeColor=#B8893C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#22324A;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1500" y="1320" width="240" height="80" />
        </mxCell>
        <mxCell id="blocked" value="&lt;b&gt;阻塞并保存上下文&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;当前运行对象让出 CPU&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2EDFA;strokeColor=#8B70AD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#22324A;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="960" width="240" height="80" />
        </mxCell>
        <mxCell id="wakeup" value="&lt;b&gt;唤醒等待者&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;重新进入就绪队列&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2EDFA;strokeColor=#8B70AD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#22324A;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="650" width="240" height="80" />
